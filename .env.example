# assayer-autodev local configuration reference.
# PLACEHOLDERS ONLY. Never put real secret values in this tracked file.

# Cloudflare Worker runtime secrets (set with `npx wrangler secret put ...`):
# AUTODEV_SERVICE_TOKEN=
# OPENAI_API_KEY=
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=

# GitHub Actions repository secrets used by isolated roles:
# AUTODEV_SERVICE_TOKEN=
# CURSOR_API_KEY=
# AUTODEV_TARGET_REPO_READ_TOKEN=
# AUTODEV_PROMOTION_GITHUB_TOKEN=

# GitHub Actions repository variables for exact-candidate browser startup.
# Values are project/runtime configuration, not credentials.
# AUTODEV_BROWSER_SETUP_COMMANDS_JSON=[]
# AUTODEV_BROWSER_SERVER_COMMAND_JSON=[]
# AUTODEV_BROWSER_SERVER_PORT=3000

# Optional budget defaults for local/dev configuration.
# ASSAYER_SOFT_BUDGET_USD=100
# ASSAYER_HARD_BUDGET_USD=500

# Dedicated Cloudflare resource identifiers are configured in wrangler.toml.
# Do not point AutoDev migrations or deployment validation at Assayer product
# databases/buckets.
