{
  "name": "assayer-autodev",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous development and verification orchestration system",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:validate": "wrangler deploy --dry-run --outdir dist/worker",
    "actuator": "tsx src/cli/run-worker.ts",
    "browser-verifier": "tsx src/cli/run-browser-verifier.ts",
    "orchestrated-verifier": "tsx src/cli/run-orchestrated-verifier.ts",
    "orchestrated-promotion": "tsx src/cli/run-orchestrated-promotion.ts",
    "validate:local": "npm run typecheck && npm run typecheck:worker && npm test && npm run worker:validate",
    "autodev:control": "tsx src/cli/autodev-control.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^22.10.0",
    "playwright": "^1.55.0",
    "sql.js": "^1.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.127.1"
  }
}
